# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_...) — the legacy "anon" key also works here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Hidden admin unlock (Google Authenticator). Create with: npm run admin:2fa
ADMIN_TOTP_SECRET=

# AI rate-list scan (Google AI Studio). Server only.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash

# Server only: the SPO activity log and `npm run seed`. Set it on Vercel too. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# 6-digit code that opens /calculator
CALCULATOR_ACCESS_CODE=

# 6-digit code for the calculator's ADMIN button (must differ from the one above)
CALCULATOR_ADMIN_CODE=
