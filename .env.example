# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_...) — the legacy "anon" key also works here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Hidden admin unlock (Google Authenticator). Create with: npm run admin:2fa
ADMIN_TOTP_SECRET=
